{
  "name": "@tinyrack/dotweave-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dotweave documentation built with Tinyrack Docs and React Router.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tinyrack-docs dev",
    "build": "tinyrack-docs build",
    "preview": "tinyrack-docs preview",
    "preview:worker": "wrangler dev",
    "start": "tinyrack-docs dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run --exclude tests/browser.test.ts",
    "test:audit": "vitest run tests/browser.test.ts",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@react-router/node": "8.2.0",
    "@tinyrack/docs": "0.3.1",
    "@tinyrack/ui": "0.3.0",
    "cobe": "^2.0.1",
    "isbot": "5.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0",
    "shiki": "4.3.1"
  },
  "devDependencies": {
    "@react-router/dev": "8.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "playwright": "1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
