{
  "name": "@tinyrack/dotweave-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dotweave documentation built with Tinyrack Docs and React Router.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "preview:worker": "wrangler dev",
    "start": "react-router dev",
    "typegen": "react-router typegen",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck": "pnpm run typegen && pnpm run typecheck:tsc",
    "test": "vitest run --config vitest.config.ts --exclude tests/browser.test.ts",
    "test:audit": "vitest run --config vitest.config.ts tests/browser.test.ts",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "validate": "node scripts/validate.ts",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@tinyrack/docs": "0.22.0",
    "@tinyrack/ui": "0.33.0",
    "cobe": "^2.0.1",
    "isbot": "5.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
